# 复制为 .env.production，并务必修改所有密码和密钥
APP_ENV=production
DEBUG=false
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Docker Compose 不内置 MySQL。请把主机名、用户名和密码替换为 backend
# 容器可访问的外部 MySQL；不要填写 127.0.0.1 或 localhost。
DATABASE_URL=mysql+pymysql://ai_teaching:replace-with-database-password@mysql.example.internal:3306/ai_teaching?charset=utf8mb4
DATABASE_SCHEMA_CHECK_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# 邮箱验证码和密码找回（生产环境禁止 console）
MAIL_BACKEND=smtp
MAIL_HOST=smtp.example.edu.cn
MAIL_PORT=465
MAIL_USERNAME=no-reply@example.edu.cn
MAIL_PASSWORD=replace-with-smtp-app-password
MAIL_FROM=no-reply@example.edu.cn
MAIL_USE_SSL=true
PASSWORD_RESET_URL=https://teaching.example.edu.cn/reset-password
EMAIL_VERIFICATION_URL=https://teaching.example.edu.cn/verify-email

# 已完成 DNS 解析时填写正式域名（如 teaching.example.edu.cn），Caddy 会自动启用 HTTPS。
# 没有域名的内网/IP 验证环境保留 :80；正式公网环境不要保留该值。
APP_SITE_ADDRESS=:80
CADDYFILE_PATH=./deploy/Caddyfile

# 默认保持模拟模式即可验证流程；接入真实 API 后改为 false
AI_MOCK_MODE=true
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 使用 DeepSeek v4 时：LLM_BASE_URL=https://api.deepseek.com，LLM_MODEL=deepseek-v4-flash

# 百炼 API Key 由 Embedding、图片理解和语音转写共用。
DASHSCOPE_API_KEY=
AI_VISION_ENABLED=true
# AI_VISION_API_KEY=仅在需要独立额度时填写
AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VISION_MODEL=qwen3-vl-plus
AI_VISION_TIMEOUT_SECONDS=90
AI_ASR_ENABLED=true
# AI_ASR_API_KEY=仅在需要独立额度时填写
AI_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_ASR_MODEL=qwen3-asr-flash
AI_ASR_TIMEOUT_SECONDS=120
AI_MEDIA_MAX_IMAGES=2
AI_MEDIA_MAX_IMAGE_MB=5
AI_MEDIA_MAX_AUDIO_MB=10
AI_MEDIA_MAX_AUDIO_SECONDS=60
AI_MEDIA_RETENTION_HOURS=24
AI_MEDIA_USER_QUOTA_MB=50
AI_MEDIA_FFPROBE_BINARY=/usr/bin/ffprobe

EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
RAG_ACTIVE_COLLECTION=
MAX_UPLOAD_SIZE_MB=100
MATERIAL_BATCH_MAX_ITEMS=500
MATERIAL_BATCH_WORKER_CONCURRENCY=2
AUTHORITY_DISCOVERY_SCHEDULER_ENABLED=false
AUTHORITY_DISCOVERY_SCHEDULER_POLL_SECONDS=300
AUTHORITY_DISCOVERY_MAX_RUNNING=1
AUTHORITY_DISCOVERY_MAX_QUEUED=5
AUTHORITY_DISCOVERY_MAX_LINKS_PER_SOURCE=20
AUTHORITY_DISCOVERY_COOLDOWN_MINUTES=30
AUTHORITY_DISCOVERY_DAILY_FETCH_LIMIT=300
AUTHORITY_DISCOVERY_REQUEST_INTERVAL_SECONDS=3

AGENT_PLANNER_ENABLED=true
AGENT_PLANNER_USE_LLM=true
AGENT_PLANNER_MAX_STEPS=5

# 教学 PPT 多模态配图；可通过 DASHSCOPE_API_KEY 复用阿里云百炼 Key。
PPT_MULTIMODAL_ENABLED=true
# PPT_MULTIMODAL_API_KEY=
PPT_MULTIMODAL_BASE_URL=https://dashscope.aliyuncs.com/api/v1
PPT_MULTIMODAL_MODEL=wan2.7-image-pro
PPT_MULTIMODAL_MAX_IMAGES=3
PPT_MULTIMODAL_TIMEOUT_SECONDS=180
