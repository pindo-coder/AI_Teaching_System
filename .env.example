OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_MODEL=gpt-4o-mini

# 阿里云百炼 Embedding、图片理解和语音转写共用这一项。
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 图片理解（OpenAI 兼容 chat/completions）。未配置密钥时前端会禁用图片入口。
# 默认复用向量模型的 DASHSCOPE_API_KEY；也可以为视觉模型单独指定 Key。
# AI_VISION_API_KEY=your_vision_api_key_here
# AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_VISION_MODEL=qwen3-vl-plus
# AI_VISION_ENABLED=true

# 语音转文字（百炼 qwen3-asr 使用兼容 chat/completions）。未配置密钥时前端会禁用录音入口。
# AI_ASR_API_KEY=your_asr_api_key_here
# AI_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_ASR_MODEL=qwen3-asr-flash
# AI_ASR_ENABLED=true

# 小服务器默认限制：图片 2 张/轮、5 MB/张；录音 60 秒、10 MB。
# AI_MEDIA_DIRECTORY=../knowledge_base/ai_media
# AI_MEDIA_MAX_IMAGES=2
# AI_MEDIA_MAX_IMAGE_MB=5
# AI_MEDIA_MAX_AUDIO_MB=10
# AI_MEDIA_MAX_AUDIO_SECONDS=60
# AI_MEDIA_RETENTION_HOURS=24
# AI_MEDIA_USER_QUOTA_MB=50
# AI_MEDIA_FFPROBE_BINARY=ffprobe

# 如果你使用讯飞兼容 OpenAI 的接口，也可以使用这两个变量名：
# XUNF_API_KEY=your_xunfei_api_key_here
# URL_XUNF_YUN=http://maas-api.cn-huabei-1.xf-yun.com/v1
