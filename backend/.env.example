APP_NAME=高校思政课 AI 智能教学辅助平台
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# 本地开发使用 SQLite；服务器可切换为：
# DATABASE_URL=mysql+pymysql://ai_teaching:密码@127.0.0.1:3306/ai_teaching?charset=utf8mb4
DATABASE_URL=sqlite:///./data/app.db
# MySQL/生产环境启动时校验 Alembic revision；除临时排障外不要关闭。
DATABASE_SCHEMA_CHECK_ENABLED=true
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
JWT_SECRET_KEY=please-change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 邮箱验证码与密码找回；本地开发保持 console，验证码会输出到后端日志，无需真实邮箱。
MAIL_BACKEND=console
# 生产环境改为 smtp，并填写以下配置。
# MAIL_BACKEND=smtp
# MAIL_HOST=smtp.example.edu.cn
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.edu.cn
MAIL_USE_SSL=true
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# 验证邮箱页面地址（验证码流程不再依赖邮件链接，保留此项仅供兼容）
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=20
PASSWORD_RESET_RATE_LIMIT_SECONDS=60
PASSWORD_RESET_HOURLY_LIMIT=5
# 管理员人工重置后的统一临时密码；用户首次登录后必须立即修改。
ADMIN_TEMPORARY_PASSWORD=12345678

# 首次启动时可选创建管理员；创建后建议清空 BOOTSTRAP_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password

# AI 配置：本地开发可保留模拟模式，不消耗模型额度
AI_MOCK_MODE=true
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# DeepSeek v4 示例（接口模型 ID 必须使用小写）：
# AI_MOCK_MODE=false
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# 也兼容 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 命名
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
# 用于加密管理员页面保存的 API Key；生产环境请设置为独立高强度随机值并保持稳定。
# 修改此值后，数据库中已有的 AI API Key 将无法解密。
AI_CONFIG_ENCRYPTION_KEY=

# 学习助手图片理解：默认直接复用下方向量模型的 DASHSCOPE_API_KEY。
# 只有需要拆分账号/额度时才配置独立 AI_VISION_API_KEY。
AI_VISION_ENABLED=true
# AI_VISION_API_KEY=
# AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_VISION_MODEL=qwen3-vl-plus
AI_VISION_TIMEOUT_SECONDS=90

# 学习助手语音转文字同样复用 DASHSCOPE_API_KEY，默认模型 qwen3-asr-flash。
AI_ASR_ENABLED=true
# AI_ASR_API_KEY=
# AI_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_ASR_MODEL=qwen3-asr-flash
AI_ASR_TIMEOUT_SECONDS=120

# 小服务器保护：分块落盘；图片前端压至 2048px；每轮最多两图，录音最长一分钟。
# 临时媒体按用户限额并在 24 小时后清理；录音时长由服务端 ffprobe 复核。
AI_MEDIA_DIRECTORY=../knowledge_base/ai_media
AI_MEDIA_MAX_IMAGES=2
AI_MEDIA_MAX_IMAGE_MB=5
AI_MEDIA_MAX_AUDIO_MB=10
AI_MEDIA_MAX_AUDIO_SECONDS=60
AI_MEDIA_RETENTION_HOURS=24
AI_MEDIA_USER_QUOTA_MB=50
AI_MEDIA_FFPROBE_BINARY=ffprobe

# RAG / Embedding；mock 模式可离线验证，也可切换 dashscope 或 openai_compatible
# DashScope 纯文本 RAG 推荐使用 text-embedding-v4（默认 1024 维）
EMBEDDING_PROVIDER=mock
# 使用阿里云百炼时改为：
# EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# OpenAI 兼容接口可复用 OPENAI_API_KEY
CHROMA_PERSIST_DIRECTORY=../knowledge_base/chroma
KNOWLEDGE_UPLOAD_DIRECTORY=../knowledge_base/uploads
GENERATED_ARTIFACT_DIRECTORY=../knowledge_base/generated_artifacts
# 教学 PPT 使用 Node 20+ 与 backend/presentation_runtime 中的 PptxGenJS 生成。
# 默认从 PATH 查找 node；宝塔或 systemd 环境找不到时填写绝对路径。
PRESENTATION_NODE_BINARY=node
# 可选：为 PPT 生成少量辅助插图。复用 DASHSCOPE_API_KEY，也可单独配置。
PPT_MULTIMODAL_ENABLED=true
# 可省略并自动复用 DASHSCOPE_API_KEY；需要单独计费时再取消注释。
# PPT_MULTIMODAL_API_KEY=
PPT_MULTIMODAL_BASE_URL=https://dashscope.aliyuncs.com/api/v1
PPT_MULTIMODAL_MODEL=wan2.7-image-pro
PPT_MULTIMODAL_MAX_IMAGES=3
PPT_MULTIMODAL_TIMEOUT_SECONDS=180
# 通常留空；只有依赖安装在自定义目录时才需要填写。
PRESENTATION_NODE_MODULES=
RAG_COLLECTION_NAME=ideology_course_kb
# 新索引验证通过后再把 RAG_ACTIVE_COLLECTION 指向版本化集合
RAG_ACTIVE_COLLECTION=
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.15
TEXT_CHUNK_SIZE=800
TEXT_CHUNK_OVERLAP=120
MAX_UPLOAD_SIZE_MB=100
# 中央材料批量网址任务：单批上限与服务器并发批次数
MATERIAL_BATCH_MAX_ITEMS=500
MATERIAL_BATCH_WORKER_CONCURRENCY=2
# 权威来源发现：先在管理后台确认白名单，再按需开启自动轮询
AUTHORITY_DISCOVERY_SCHEDULER_ENABLED=false
AUTHORITY_DISCOVERY_SCHEDULER_POLL_SECONDS=300
# 单机发现任务保护：最多同时运行 1 个、排队 5 个；同条件任务 30 分钟内不重复创建。
AUTHORITY_DISCOVERY_MAX_RUNNING=1
AUTHORITY_DISCOVERY_MAX_QUEUED=5
AUTHORITY_DISCOVERY_MAX_LINKS_PER_SOURCE=20
AUTHORITY_DISCOVERY_COOLDOWN_MINUTES=30
AUTHORITY_DISCOVERY_DAILY_FETCH_LIMIT=300
AUTHORITY_DISCOVERY_REQUEST_INTERVAL_SECONDS=3
AUTHORITY_DISCOVERY_MIN_RELEVANCE_SCORE=0.55
AUTHORITY_DISCOVERY_MIN_ASSOCIATION_SCORE=0.45
AUTHORITY_DISCOVERY_MIN_EXTRACTION_QUALITY=0.60
AUTHORITY_DISCOVERY_IMPORTANCE_THRESHOLD=0.60
# 教材匹配：默认保持轻量确定性路径；安装 requirements-matching.txt 后可按需启用。
AUTHORITY_MATCHING_RRF_RANK_CONSTANT=60
AUTHORITY_MATCHING_MAX_CHAPTERS=3
AUTHORITY_MATCHING_MIN_RAW_SCORE=0.32
AUTHORITY_MATCHING_CANDIDATE_RETENTION_SCORE=0.20
AUTHORITY_MATCHING_CANDIDATE_RELEVANCE_SCORE=0.35
AUTHORITY_MATCHING_ALERT_SCORE=0.72
AUTHORITY_MATCHING_RERANKER_ENABLED=false
AUTHORITY_MATCHING_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AUTHORITY_MATCHING_RERANKER_THRESHOLD=0.45
AUTHORITY_MATCHING_RERANKER_DEVICE=cpu
AUTHORITY_MATCHING_NLI_ENABLED=false
AUTHORITY_MATCHING_NLI_MODEL=IDEA-CCNL/Erlangshen-Roberta-110M-NLI
AUTHORITY_MATCHING_NLI_NEUTRAL_THRESHOLD=0.55
AUTHORITY_MATCHING_NLI_DEVICE=cpu

# 规划型 Agent：会自主选择受控工具并按步骤执行；副作用操作仍需人工确认
AGENT_PLANNER_ENABLED=true
AGENT_PLANNER_USE_LLM=true
AGENT_PLANNER_MAX_STEPS=5
